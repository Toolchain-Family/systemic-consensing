{
  "tool": "Systemic Consensing",
  "version": "1.0.0",
  "description": "Entscheidungs-Tool nach der Methode des Systemischen Konsenses: Optionen mit minimalem Widerstand statt maximaler Zustimmung finden. Teilnehmer bewerten jede Option mit einer Widerstands-Skala von 0 bis 10.",
  "roles": [
    {
      "key": "consensusSession",
      "name": "Consensus Session",
      "description": "Container-Dokument einer Systemischen-Konsens-Abstimmung mit Frage, Optionen, Zeitlimit und den Widerstands-Bewertungen der Teilnehmer",
      "structure": [
        {
          "key": "title",
          "display": "Title",
          "type": "string"
        },
        {
          "key": "question",
          "display": "Question",
          "type": "string"
        },
        {
          "key": "options",
          "display": "Options",
          "type": "array",
          "items": "string"
        },
        {
          "key": "endTime",
          "display": "End Time",
          "type": "string"
        },
        {
          "key": "status",
          "display": "Status",
          "type": "string"
        },
        {
          "key": "votes",
          "display": "Votes",
          "type": "object"
        }
      ]
    }
  ],
  "icon": ""
}
